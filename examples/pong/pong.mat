material {
    name : EshiGlowPong,
    parameters : [
        {
            type : float[64],
            name : eshiUniforms
        },
        {
            type : float2,
            name : eshiResolution
        },
        {
            type : float,
            name : eshiTime
        }
    ],
    variables : [
        eshiPosition
    ],
    vertexDomain : device,
    depthWrite : false,
    depthCulling : false,
    culling : none,
    shadingModel : unlit,
    variantFilter : [ skinning, shadowReceiver, vsm ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.eshiPosition.xy = getPosition().xy;
    }
}

fragment {
    float sdBox(vec2 p, vec2 b) {
        vec2 d = abs(p) - b;
        return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0);
    }

    float glow(float d, float intensity) {
        return intensity / (d * d + 0.0001);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        const float paddleHalfW = 0.02;
        const float paddleHalfH = 0.2;
        const float ballRadius = 0.03;
        const float arenaY = 1.0;

        vec2 paddleL = vec2(materialParams.eshiUniforms[0],
                            materialParams.eshiUniforms[1]);
        vec2 paddleR = vec2(materialParams.eshiUniforms[2],
                            materialParams.eshiUniforms[3]);
        vec2 ball = vec2(materialParams.eshiUniforms[4],
                         materialParams.eshiUniforms[5]);
        float hitTimer = materialParams.eshiUniforms[6];
        float scoreL = materialParams.eshiUniforms[7];
        float scoreR = materialParams.eshiUniforms[8];

        vec2 uv = variable_eshiPosition.xy;
        uv.x *= materialParams.eshiResolution.x / materialParams.eshiResolution.y;

        float dLeft = sdBox(uv - paddleL, vec2(paddleHalfW, paddleHalfH));
        float dRight = sdBox(uv - paddleR, vec2(paddleHalfW, paddleHalfH));
        float dBall = length(uv - ball) - ballRadius;

        vec3 col = vec3(0.0);
        col += vec3(0.2, 0.8, 1.0) * glow(dLeft, 0.002);
        col += vec3(1.0, 0.2, 0.5) * glow(dRight, 0.002);
        col += vec3(1.0) * glow(dBall, 0.005);
        col += vec3(1.0) * hitTimer * 0.35 * exp(-length(uv - ball) * 2.0);

        if (abs(uv.x) < 0.004 &&
                fract(uv.y * 6.0 + materialParams.eshiTime * 0.1) < 0.5) {
            col += vec3(0.18);
        }

        for (int i = 0; i < 9; ++i) {
            float fx = 0.08 * float(i + 1);
            if (scoreL > float(i)) {
                col += vec3(0.2, 0.8, 1.0) *
                        glow(length(uv - vec2(-fx, arenaY - 0.08)) - 0.012, 0.0004);
            }
            if (scoreR > float(i)) {
                col += vec3(1.0, 0.2, 0.5) *
                        glow(length(uv - vec2(fx, arenaY - 0.08)) - 0.012, 0.0004);
            }
        }

        material.baseColor = vec4(col, 1.0);
    }
}
